generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid())
  twitchId              String    @unique
  username              String
  email                 String?
  createdAt             DateTime  @default(now())
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  updatedAt             DateTime  @updatedAt
  tenants               Tenant[]  @relation("TenantOwner")
}

model Tenant {
  id              String          @id @default(uuid())
  ownerId         String
  planTier        PlanTier        @default(FREE)
  stripeSubId     String?
  settings        Json?
  isConnected     Boolean         @default(false)
  name            String
  twitchId        String          @unique
  encryptedBotAccessToken  String?
  encryptedBotRefreshToken String?
  botUsername     String?
  targetChannel   String?
  auditLogs       AuditLog[]
  chatLogs        ChatLog[]
  commands        Command[]
  eventLogs       EventLog[]
  modRules        ModRule[]
  owner           User            @relation("TenantOwner", fields: [ownerId], references: [id])
  timers          Timer[]
  viewerProfiles  ViewerProfile[]
  integrations    Integration[]
  
  // Loyalty System
  skillNodes      SkillNode[]
  achievements    Achievement[]
  seasons         Season[]
  
  // Battle System
  battles         Battle[]
  
  // Overlay Creator
  overlays        Overlay[]  @relation("TenantOverlays")
  
  onboarding      Onboarding?
}

model Onboarding {
  id                  String    @id @default(uuid())
  tenantId            String    @unique
  hasLinkedBot        Boolean   @default(false)
  hasCreatedCommand   Boolean   @default(false)
  hasEnabledModeration Boolean  @default(false)
  hasVisitedDashboard Boolean   @default(false)
  hasImportedCommands Boolean   @default(false)
  completedAt         DateTime?
  
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
}

model Integration {
  id                    String   @id @default(uuid())
  tenantId              String
  provider              String   // "nightbot", "streamelements", "fossabot"
  externalUserId        String?
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
}

model Command {
  id           String       @id @default(uuid())
  tenantId     String
  trigger      String
  enabled      Boolean      @default(true)
  cooldown     Int          @default(0)
  userCooldown Int          @default(0)
  userLevel    UserLevel    @default(VIEWER)
  responses    Json
  responseType ResponseType @default(SAY)
  aliases      Json?
  usages       Int          @default(0)
  description  String?
  category     String       @default("General")
  isBuiltIn    Boolean      @default(false)
  isRegex      Boolean      @default(false)
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, trigger])
}

enum ResponseType {
  SAY
  MENTION
  REPLY
  WHISPER
}

model Timer {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  message         String
  intervalSeconds Int      @default(300)
  chatLines       Int      @default(1)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

model ModRule {
  id       String  @id @default(uuid())
  tenantId String
  type     String
  enabled  Boolean @default(true)
  settings Json?
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
}

model ViewerProfile {
  id           String   @id @default(uuid())
  tenantId     String
  twitchUserId String
  xp           Int      @default(0)
  firstSeenAt  DateTime @default(now())
  lastActiveAt DateTime @default(now())
  level        Int      @default(1)
  points       Int      @default(0)
  username     String
  watchTime    Int      @default(0)
  
  // Loyalty System
  prestigeLevel Int      @default(0)
  skillPoints   Int      @default(0)
  seasonXp      Int      @default(0)
  
  // Battle System
  mmr           Int      @default(1000)
  
  battlesAsChallenger Battle[] @relation("BattleChallenger")
  battlesAsOpponent   Battle[] @relation("BattleOpponent")
  battlesWon          Battle[] @relation("BattleWinner")
  
  unlockedSkills       UserSkill[]
  unlockedAchievements UserAchievement[]
  
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, twitchUserId])
}

model SkillNode {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String
  effectType  String   // e.g., "PASSIVE_XP", "DISCOUNT_GAMBLE", "LUCK_HEIST"
  effectValue Float
  cost        Int
  parentId    String?
  parent      SkillNode? @relation("SkillTree", fields: [parentId], references: [id])
  children    SkillNode[] @relation("SkillTree")
  
  unlockedBy  UserSkill[]
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
}

model UserSkill {
  id              String        @id @default(uuid())
  viewerProfileId String
  skillNodeId     String
  unlockedAt      DateTime      @default(now())
  
  viewerProfile   ViewerProfile @relation(fields: [viewerProfileId], references: [id])
  skillNode       SkillNode     @relation(fields: [skillNodeId], references: [id])
  
  @@unique([viewerProfileId, skillNodeId])
}

model Achievement {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String
  triggerType String   // e.g., "MESSAGE_COUNT", "WATCH_TIME", "RAID_PARTICIPATION"
  threshold   Int
  rewardXp    Int
  icon        String?
  
  unlockedBy  UserAchievement[]
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
}

model UserAchievement {
  id              String        @id @default(uuid())
  viewerProfileId String
  achievementId   String
  unlockedAt      DateTime      @default(now())
  
  viewerProfile   ViewerProfile @relation(fields: [viewerProfileId], references: [id])
  achievement     Achievement   @relation(fields: [achievementId], references: [id])
  
  @@unique([viewerProfileId, achievementId])
}

model Season {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model Battle {
  id              String        @id @default(uuid())
  tenantId        String
  challengerId    String
  opponentId      String
  challengerRoll  Int
  opponentRoll    Int
  winnerId        String
  mmrChange       Int
  createdAt       DateTime      @default(now())
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  challenger      ViewerProfile @relation("BattleChallenger", fields: [challengerId], references: [id])
  opponent        ViewerProfile @relation("BattleOpponent", fields: [opponentId], references: [id])
  winner          ViewerProfile @relation("BattleWinner", fields: [winnerId], references: [id])
}

model ChatLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String
  viewerId  String
  message   String
  timestamp DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model EventLog {
  id        String   @id @default(uuid())
  tenantId  String
  type      String
  data      Json
  timestamp DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  action    String   // e.g., "TIMEOUT", "BAN", "COMMAND_ADD", "TIMER_UPDATE"
  actor     String   // e.g., "streamer", "bot", "moderator_name"
  target    String?  // e.g., "viewer_name"
  metadata  Json?    // e.g., { reason: "spam", duration: 600 }
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

enum PlanTier {
  FREE
  PRO
  PARTNER
}

enum UserLevel {
  VIEWER
  SUBSCRIBER
  VIP
  MODERATOR
  BROADCASTER
}

// Overlay Creator Models
model Overlay {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation("TenantOverlays", fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  
  // Canvas settings
  width       Int      @default(1920)
  height      Int      @default(1080)
  
  // Overlay configuration (JSON)
  config      Json     @default("{}")
  
  // Browser source settings
  isPublic    Boolean  @default(true)
  urlSlug     String   @unique
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  widgets     OverlayWidget[]
  
  @@index([tenantId])
  @@index([urlSlug])
}

model OverlayWidget {
  id         String   @id @default(uuid())
  overlayId  String
  overlay    Overlay  @relation(fields: [overlayId], references: [id], onDelete: Cascade)
  
  // Widget type (alert, chat, goal, timer, etc.)
  type       String
  
  // Position and size
  x          Int      @default(0)
  y          Int      @default(0)
  width      Int      @default(300)
  height     Int      @default(200)
  zIndex     Int      @default(0)
  
  // Widget-specific configuration (JSON)
  config     Json     @default("{}")
  
  // Styling
  styles     Json     @default("{}")
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([overlayId])
}


